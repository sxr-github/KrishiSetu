# KrishiSetu - example environment variables (Phase 0)
# Copy to .env and adjust locally. Never commit real secrets.

# Backend runtime
NODE_ENV=development
PORT=4000

# Web app (Vite exposes only VITE_* variables to the browser)
VITE_API_BASE_URL=http://localhost:4000

# Mobile app (Expo exposes only EXPO_PUBLIC_* variables to the client)
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000

# Future phases will introduce additional variables (database, auth, external
# services). They are intentionally not defined yet - see PROJECT_STATUS.md.
